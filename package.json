{
	"name": "wichtel-generator",
	"private": true,
	"version": "2.0.0",
	"description": "Online-Wichteltopf: Teilnehmende eintragen, Topf schließen, Wichtel auslosen.",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node src/server.ts",
		"dev": "node --watch src/server.ts",
		"cf:dev": "wrangler d1 migrations apply DB --local && wrangler dev",
		"deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
		"test": "node --test \"test/**/*.test.ts\"",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=90 \"test/**/*.test.ts\"",
		"test:mobile": "node scripts/mobile-check.ts",
		"test:e2e": "playwright test",
		"screenshots": "node scripts/screenshots.ts",
		"smoke": "node scripts/smoke-test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "npm run typecheck && npm run lint && npm test",
		"images": "./scripts/build-images.sh",
		"assets": "node scripts/build-assets.ts",
		"upgrade": "npx npm-check-updates -u && npm install && npm audit fix"
	},
	"author": "Michael Kreil",
	"license": "MIT",
	"dependencies": {
		"@hono/node-server": "^2.1.5",
		"hono": "^4.13.13"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.5",
		"npm-check-updates": "^23.1.1",
		"typescript": "^7.0.2",
		"wrangler": "^4.151.0"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true,
		"workerd": true
	}
}
